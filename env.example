# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# SECRET - server only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Groq ----------
GROQ_API_KEY=your-gemini-api-key
GROQ_MODEL=gemini-2.5-flash

# ---------- M-Pesa (Safaricom Daraja) ----------
# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# Paybill number, or the Head Office / Store number for a Till
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional. Defaults to MPESA_SHORTCODE. For a Till, set this to the Till number.
MPESA_PARTY_B=
# Long random string. Daraja callbacks are only accepted if they carry this token.
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
# Public HTTPS URL of your deployment, no trailing slash
APP_URL=https://your-app.vercel.app
